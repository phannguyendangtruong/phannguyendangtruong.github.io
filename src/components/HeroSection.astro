---
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import NetworkMap from './metro/NetworkMap.astro';
import { profile } from '../data/profile';
import { localePath, tr, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
/** "Java Backend Developer · 3 years · Hanoi". */
const years = tr('heroYears', lang).replace('{n}', String(profile.stats.years));
const roleLine = [profile.jobTitle, years, profile.city[lang]].join(' · ');
---

<section id="top" class="hero" aria-labelledby="hero-name">
  <div class="container hero-in">
    <div class="hero-text">
      <h1 id="hero-name" class="hero-name">{profile.name[lang]}</h1>
      <p class="hero-role">{roleLine}</p>
      <p class="hero-tagline">{profile.tagline[lang]}</p>
      <div class="hero-ctas">
        <a class="button primary" href="#experience">
          {tr('followRoute', lang)}
          <Icon name="arrow-down" size={16} />
        </a>
        <a class="button secondary" href={localePath(lang, '/cv/')}>{tr('viewResume', lang)}</a>
        {
          profile.links.linkedin && (
            <ExternalLink
              href={profile.links.linkedin}
              lang={lang}
              label={profile.linkNames.linkedin}
              icon="linkedin"
              class="text-link"
            />
          )
        }
        {
          profile.links.github && (
            <ExternalLink href={profile.links.github} lang={lang} label={profile.linkNames.github} icon="github" class="text-link" />
          )
        }
      </div>
    </div>
    <div class="hero-map">
      <NetworkMap lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 24px 0 32px;
  }

  /* Phone: the text, then the map right under the buttons. */
  .hero-in {
    display: grid;
    gap: 28px;
  }

  .hero-text,
  .hero-map {
    min-width: 0;
  }

  /* The name size also follows the text column, so it keeps to two lines next to the map. */
  .hero-text {
    container-type: inline-size;
  }

  .hero-name {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-size: clamp(2.75rem, min(7vw, 17cqi), 6rem);
    letter-spacing: -0.01em;
    line-height: 0.98;
    color: var(--text);
  }

  .hero-role {
    margin: 16px 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .hero-tagline {
    max-width: 60ch;
    margin: 12px 0 0;
    color: var(--muted);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 24px;
  }

  .hero-ctas .button {
    min-height: 48px;
    padding: 0 22px;
  }

  .hero-ctas :global(.text-link svg:not(.ext)) {
    width: 16px;
    height: 16px;
  }

  @media (min-width: 640px) {
    .hero {
      padding: 40px 0 48px;
    }

    /* Tablet: the text on the left and the compact map on the right, its top level with the name. The map column
       follows the width (280px to 400px), so its labels stay about the size they have on a phone. */
    .hero-in {
      grid-template-columns: minmax(0, 1fr) clamp(280px, 42%, 400px);
      align-items: start;
      gap: 36px;
    }

    .hero-role {
      margin-top: 20px;
      font-size: 1.125rem;
    }
  }

  /* Desktop: the map spans the whole width and the text block sits over its top-left corner, which the map leaves
     empty (src/data/network-layout.ts › wideMap). The block keeps a fixed width, so its height hardly changes from
     1024px up and line 3 always runs under the buttons. The block comes first in the stacking order, so the map
     never covers its links. */
  @media (min-width: 1024px) {
    .hero {
      padding: 32px 0 56px;
    }

    .hero-in {
      grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
      align-items: start;
      gap: 0;
    }

    .hero-text {
      position: relative;
      z-index: 1;
      grid-area: 1 / 1;
      padding-top: 24px;
    }

    .hero-map {
      grid-area: 1 / 1 / 2 / -1;
    }
  }
</style>
