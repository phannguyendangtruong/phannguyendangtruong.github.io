---
import LangSwitch from './LangSwitch.astro';
import MobileMenu from './MobileMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';
import { navItems, type NavKey } from '../i18n/nav';
import { keyLabels, localePath, tr, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Path of this page without the language prefix, e.g. "/cv/". */
  path: string;
  /** Nav item marked as the current page. */
  current?: NavKey;
  /** 'minimal' keeps only the name and the theme button (404 page). */
  variant?: 'full' | 'minimal';
}

const { lang, path, current, variant = 'full' } = Astro.props;
const minimal = variant === 'minimal';
const brandLang: Lang = minimal ? 'en' : lang;
---

<header class="site-header no-print">
  <div class:list={['container', 'nav-row', { minimal }]}>
    <a class="brand" href={localePath(brandLang, '/')}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{profile.name[brandLang]}</span>
    </a>
    {
      minimal ? (
        <div class="nav-end">
          <ThemeToggle lang={lang} bilingual large />
        </div>
      ) : (
        <>
          <nav class="site-nav" aria-label={tr('navMain', lang)}>
            <ul class="nav-list">
              {navItems.map((item) => (
                <li>
                  <a
                    class="nav-link"
                    href={localePath(lang, item.target)}
                    data-nav={item.key}
                    aria-current={item.key === current ? 'page' : undefined}
                  >
                    {tr(item.label, lang)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="nav-actions">
            <button
              type="button"
              id="cmdk-open"
              class="chip-btn kbd js-only"
              aria-haspopup="dialog"
              aria-label={tr('cmdkOpen', lang)}
            >
              <span class="k-mac" aria-hidden="true">{keyLabels.paletteMac}</span>
              <span class="k-other" aria-hidden="true">{keyLabels.paletteOther}</span>
            </button>
            <LangSwitch lang={lang} path={path} />
            <ThemeToggle lang={lang} />
          </div>
          <MobileMenu lang={lang} path={path} />
        </>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(150%) blur(14px);
    backdrop-filter: saturate(150%) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  /* Solid header while the mobile menu is open; the class is the fallback for browsers without :has(). */
  .site-header.menu-open {
    background: var(--surface);
  }

  .site-header:has(:global(.mnav[open])) {
    background: var(--surface);
  }

  .nav-row {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 16px;
    white-space: nowrap;
  }

  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    max-width: 100%;
    color: var(--text);
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-mark {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--grad);
    box-shadow: 0 0 12px var(--glow);
    transform: rotate(45deg);
  }

  .site-nav,
  .nav-actions {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--text);
  }

  .nav-link[aria-current]::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 5px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad);
  }

  .nav-actions,
  .nav-end {
    justify-self: end;
    align-items: center;
    gap: 8px;
  }

  .nav-end {
    display: flex;
  }

  .k-mac,
  :global(:root[data-os='mac']) .k-other {
    display: none;
  }

  :global(:root[data-os='mac']) .k-mac {
    display: inline;
  }

  @media (min-width: 960px) {
    .nav-row {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-nav {
      display: block;
    }

    .nav-actions {
      display: flex;
    }
  }

  .nav-row.minimal {
    grid-template-columns: 1fr auto;
  }
</style>
