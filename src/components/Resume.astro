---
import Base from '../layouts/Base.astro';
import CvSectionTitle from './cv/CvSectionTitle.astro';
import ExperienceList from './ExperienceList.astro';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import SkillsList from './SkillsList.astro';
import { education, profile, projects, statusLabel } from '../data/profile';
import { caseStudyProjects } from '../i18n/nav';
import { localePath, tr, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const caseStudySlugs = caseStudyProjects().map((project) => project.slug);
const shown = projects
  .filter((project) => project.status !== 'planned')
  .map((project) => ({
    project,
    points: project.points ? project.points[lang].slice(0, 3) : [],
    caseStudy:
      project.slug && caseStudySlugs.includes(project.slug) ? localePath(lang, `/projects/${project.slug}/`) : undefined,
  }));
const title = `${tr('navResume', lang)} — ${profile.name[lang]}`;
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
/** Set to true when the printed CV runs past two A4 pages: projects then print without their points. */
const compactProjectsInPrint = false;
---

<Base lang={lang} title={title} description={tr('resumeDescription', lang)} path="/cv/" current="resume">
  <div class="cv-page">
    <div class="container">
      <div class="cv-wrap">
        <div class="cv-toolbar no-print">
          <div class="cv-actions">
            <a class="back-link" href={localePath(lang, '/')}>
              <Icon name="arrow-left" size={16} />
              <span>{tr('backHome', lang)}</span>
            </a>
            <button type="button" class="button primary js-only cv-print" data-print>
              <Icon name="printer" size={16} />
              <span>{tr('printResume', lang)}</span>
            </button>
            <p class="print-hint">{tr('printHint', lang)}</p>
          </div>
        </div>

        <article class="sheet" aria-labelledby="cv-name">
          <header class="cv-head">
            <h1 id="cv-name" class="cv-name">{profile.name[lang]}</h1>
            <p class="cv-role">{profile.role[lang]} · {profile.location[lang]}</p>
            <ul class="cv-links">
              <li>
                <ExternalLink
                  href={profile.links.linkedin}
                  lang={lang}
                  label={host(profile.links.linkedin)}
                  icon="linkedin"
                  class="cv-link"
                />
              </li>
              <li>
                <ExternalLink
                  href={profile.links.github}
                  lang={lang}
                  label={host(profile.links.github)}
                  icon="github"
                  class="cv-link"
                />
              </li>
            </ul>
            <p class="cv-note">{tr('resumeNote', lang)}</p>
          </header>

          <section class="cv-section" aria-labelledby="cv-summary-title">
            <CvSectionTitle lang={lang} id="cv-summary-title" title="summaryTitle" />
            <p class="cv-lead">{profile.tagline[lang]}</p>
            <p class="cv-about">{profile.about[lang][0]}</p>
          </section>

          <section class="cv-section" aria-labelledby="cv-skills-title">
            <CvSectionTitle lang={lang} id="cv-skills-title" title="skillsTitle" />
            <SkillsList lang={lang} />
          </section>

          <section class="cv-section" aria-labelledby="cv-exp-title">
            <CvSectionTitle lang={lang} id="cv-exp-title" title="experienceTitle" />
            <ExperienceList lang={lang} />
          </section>

          {
            shown.length > 0 && (
              <section
                class:list={['cv-section', { 'print-compact': compactProjectsInPrint }]}
                aria-labelledby="cv-proj-title"
              >
                <CvSectionTitle lang={lang} id="cv-proj-title" title="projectsTitle" />
                {shown.map(({ project, points, caseStudy }) => (
                  <div class="cv-pproj">
                    <div class="cv-pproj-head">
                      <h3>{project.name}</h3>
                      <span class:list={['badge', project.status]}>{tr(statusLabel[project.status], lang)}</span>
                    </div>
                    <p class="cv-desc">{project.summary[lang]}</p>
                    {points.length > 0 && (
                      <ul class="dash-list cv-bullets cv-points">
                        {points.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    )}
                    <p class="cv-tech">
                      <span class="sr-only">{tr('techLabel', lang)}</span> {project.tech.join(' · ')}
                    </p>
                    {(project.demoUrl || project.repoUrl) && (
                      <div class="cv-plinks no-print">
                        {project.demoUrl && (
                          <ExternalLink href={project.demoUrl} lang={lang} label={tr('demo', lang)} class="text-link" />
                        )}
                        {project.repoUrl && (
                          <ExternalLink href={project.repoUrl} lang={lang} label={tr('repository', lang)} class="text-link" />
                        )}
                      </div>
                    )}
                    {caseStudy && (
                      <a class="text-link accent cv-case no-print" href={caseStudy}>
                        <span>{tr('readCaseStudy', lang)}</span>
                        <span class="sr-only">{` ${project.name}`}</span>
                        <Icon name="arrow-right" size={16} />
                      </a>
                    )}
                  </div>
                ))}
              </section>
            )
          }

          <section class="cv-section" aria-labelledby="cv-edu-title">
            <CvSectionTitle lang={lang} id="cv-edu-title" title="educationTitle" />
            <p class="cv-edu">{education.school[lang]}</p>
          </section>
        </article>
      </div>
    </div>
  </div>
</Base>

<style>
  /* A4 for the CV only: Astro does not scope @page, and this CSS ships with the two CV pages alone. */
  @page {
    size: A4 portrait;
    margin: 15mm;
  }

  .cv-wrap {
    max-width: 800px;
    margin: 0 auto;
  }

  .cv-toolbar {
    padding: 20px 0 16px;
  }

  /* Back link on the left, print button on the right; without JavaScript the hint takes its own row on a phone. */
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--text);
    font-weight: 500;
  }

  /* Phone: a compact outlined button, so the way back home stays the clearest action; solid from 640px. */
  .cv-actions .cv-print {
    min-height: 44px;
    padding: 0 14px;
    border-color: var(--border-strong);
    background: transparent;
    color: var(--text);
    font-size: 0.9375rem;
  }

  .cv-actions .cv-print:hover {
    border-color: var(--text);
    background: transparent;
  }

  .print-hint {
    flex: 1 1 100%;
    margin: 0;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  :global(html.js) .print-hint {
    display: none;
  }

  /* Flat sheet on the page: one surface and a 1px edge; no blur, no light, no lift, no reveal. */
  .sheet {
    margin-bottom: 40px;
    padding: 24px 18px 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .cv-name {
    margin: 0;
    font-size: clamp(2.25rem, 1.75rem + 2.5vw, 3.25rem);
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--text);
  }

  .cv-role {
    margin: 10px 0 0;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--muted);
  }

  /* Phone: one link per row, each 44px high; long addresses may break anywhere instead of overflowing. */
  .cv-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .cv-links li {
    min-width: 0;
    max-width: 100%;
  }

  .cv-links :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    min-height: 44px;
    font: 500 0.9375rem/1.4 var(--font);
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .cv-links :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cv-links :global(a > svg:not(.ext)) {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--muted);
  }

  .cv-links :global(.ext) {
    width: 12px;
    height: 12px;
    color: var(--faint);
  }

  .cv-note {
    margin: 12px 0 0;
    padding-left: 12px;
    border-left: 2px solid var(--border-strong);
    font-size: 0.875rem;
    color: var(--faint);
  }

  .cv-section {
    margin-top: 32px;
  }

  /* Elements rendered by CvSectionTitle, ExperienceList and SkillsList are styled here, so print sizes live in one
     place. Section sign: condensed capitals over a thin band of the line colours. */
  .sheet :global(.cv-h2) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0 0 16px;
    font: 700 clamp(1.5rem, 1.25rem + 1vw, 1.875rem) / 1.05 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text);
  }

  .sheet :global(.cv-band) {
    display: flex;
    align-items: center;
  }

  .sheet :global(.cv-band span) {
    width: 24px;
    height: 4px;
    background: var(--line);
  }

  /* A hairline runs on from the band to the edge of the sheet. */
  .sheet :global(.cv-band::after) {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .cv-lead {
    max-width: 70ch;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text);
  }

  .cv-about {
    max-width: 70ch;
    margin: 10px 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .sheet :global(.cv-jobs) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sheet :global(.cv-job) {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .sheet :global(.cv-job:last-child) {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }

  /* Phone: company, role, then period, all left aligned. */
  .sheet :global(.cv-job-head) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin-bottom: 14px;
  }

  /* Line bullet before the company name, the role under the name. The name gives the baseline of the block. */
  .sheet :global(.cv-job-title) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 10px;
    min-width: 0;
  }

  .sheet :global(.cv-job-title h3) {
    align-self: baseline;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .sheet :global(.cv-job-role) {
    grid-column: 2;
    margin: 2px 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* Phone: under the role, lined up with the company name. */
  .sheet :global(.cv-period) {
    margin: 0;
    padding-left: 30px;
    font: 500 0.9375rem/1.5 var(--font);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Each project is a station on the line of its company: a ring on a track in the line colour, under the bullet. */
  .sheet :global(.cv-proj) {
    position: relative;
    margin-left: 8.5px;
    padding: 0 0 20px 18px;
    border-left: 3px solid var(--line);
  }

  .sheet :global(.cv-proj:last-child) {
    padding-bottom: 0;
  }

  .sheet :global(.cv-proj::before) {
    content: '';
    position: absolute;
    left: -8.5px;
    top: 5px;
    width: 14px;
    height: 14px;
    border: 3px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
  }

  .sheet :global(.cv-proj h3) {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .sheet :global(.cv-desc) {
    margin: 6px 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .sheet :global(.cv-bullets) {
    gap: 6px;
    margin-top: 10px;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .sheet :global(.cv-tech) {
    margin: 10px 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--faint);
  }

  .cv-pproj + .cv-pproj {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .cv-pproj-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .cv-pproj-head h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .cv-pproj .cv-desc {
    margin-top: 10px;
    font-size: 0.9375rem;
  }

  .cv-plinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin-top: 8px;
  }

  .cv-case {
    gap: 6px;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 600;
  }

  .cv-case:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cv-case :global(svg) {
    width: 16px;
    height: 16px;
  }

  /* Key of the bullets in the skills list: each line with its company. */
  .sheet :global(.cv-legend) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  .sheet :global(.cv-legend li) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .sheet :global(.cv-skills) {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }

  /* Phone: group name above, skills below. */
  .sheet :global(.cv-skill) {
    display: grid;
    gap: 4px;
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .sheet :global(.cv-skill dt) {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .sheet :global(.cv-skill dd) {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  /* A technology stays in one piece with the bullets of the lines that meet there and its separator. */
  .sheet :global(.cv-skill-item) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    min-width: 0;
    color: var(--text);
  }

  .sheet :global(.cv-skill-lines) {
    display: inline-flex;
    gap: 2px;
  }

  .sheet :global(.cv-sep) {
    color: var(--faint);
  }

  .cv-edu {
    margin: 0;
    font-size: 1rem;
  }

  @media (min-width: 640px) {
    .cv-toolbar {
      padding: 40px 0 20px;
    }

    .cv-actions .cv-print {
      padding: 0 20px;
      border-color: transparent;
      background: var(--btn-bg);
      color: var(--accent-text);
      font-size: 1rem;
    }

    .cv-actions .cv-print:hover {
      background: color-mix(in srgb, var(--btn-bg) 85%, var(--text));
    }

    .print-hint {
      flex: none;
    }

    .sheet {
      margin-bottom: 56px;
      padding: 40px 48px 44px;
    }

    .cv-links {
      gap: 8px 24px;
      margin-top: 18px;
    }

    .cv-links :global(a) {
      gap: 8px;
      min-height: 32px;
    }

    .cv-note {
      margin-top: 14px;
    }

    .cv-section {
      margin-top: 44px;
    }

    .sheet :global(.cv-h2) {
      margin-bottom: 20px;
    }

    .cv-about {
      margin-top: 12px;
    }

    .sheet :global(.cv-job) {
      margin-bottom: 28px;
      padding-bottom: 28px;
    }

    .sheet :global(.cv-job-head) {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 4px 16px;
    }

    .sheet :global(.cv-period) {
      padding-left: 0;
      text-align: right;
    }

    .cv-pproj + .cv-pproj {
      margin-top: 28px;
      padding-top: 28px;
    }

    .cv-case {
      margin-top: 14px;
    }

    .sheet :global(.cv-skill) {
      grid-template-columns: 200px 1fr;
      column-gap: 20px;
      row-gap: 0;
      align-items: start;
      padding: 11px 0;
    }
  }

  /* A4 print: black on white from the print variables of global.css. Print width (about 680px) still matches
     min-width: 640px, so the layout is set again here explicitly. */
  @media print {
    :global(.skip-link) {
      display: none !important;
    }

    .container,
    .cv-wrap {
      max-width: none;
      margin: 0;
      padding: 0;
    }

    .sheet {
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      font-size: 10pt;
      line-height: 1.4;
    }

    .badge::before,
    .cv-links :global(.ext),
    .sheet :global(.cv-proj::before) {
      display: none;
    }

    .sheet :global(a) {
      color: inherit;
      text-decoration: none;
    }

    .cv-name {
      font-size: 20pt;
      font-weight: 700;
      line-height: 1.15;
    }

    .cv-role {
      margin-top: 2pt;
      font-size: 10.5pt;
    }

    .cv-links {
      gap: 2pt 14pt;
      margin-top: 6pt;
    }

    .cv-links :global(a) {
      gap: 4pt;
      min-height: 0;
      font-size: 9.5pt;
    }

    .cv-links :global(a > svg:not(.ext)) {
      width: 9pt;
      height: 9pt;
    }

    .cv-note {
      margin-top: 5pt;
      padding-left: 0;
      border-left: 0;
      font-size: 9.5pt;
    }

    .cv-section {
      margin-top: 12pt;
    }

    .sheet :global(.cv-h2) {
      margin: 0 0 6pt;
      padding-bottom: 2pt;
      border-bottom: 0.75pt solid var(--text);
      font: 700 10.5pt/1.2 var(--font);
      letter-spacing: 0.08em;
      break-after: avoid;
      page-break-after: avoid;
    }

    .cv-lead,
    .cv-about,
    .cv-edu,
    .sheet :global(.cv-desc),
    .sheet :global(.cv-bullets) {
      max-width: none;
      font-size: 10pt;
      line-height: 1.4;
    }

    .cv-about {
      margin-top: 4pt;
    }

    .sheet :global(.cv-desc) {
      margin-top: 1pt;
    }

    .sheet :global(.cv-job) {
      margin: 0 0 9pt;
      padding: 0;
      border: 0;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .sheet :global(.cv-job:last-child) {
      margin-bottom: 0;
    }

    .sheet :global(.cv-job-head) {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 0 8pt;
      margin-bottom: 0;
    }

    /* Bullet ring and role on the company line: "3 Viettel — Java Developer". */
    .sheet :global(.cv-job-title) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 4pt;
    }

    .sheet :global(.cv-job-title h3) {
      font-size: 11pt;
      font-weight: 700;
    }

    .sheet :global(.cv-job-role) {
      margin: 0;
      font-size: 10pt;
    }

    .sheet :global(.cv-job-role::before) {
      content: '— ';
    }

    .sheet :global(.cv-period) {
      padding-left: 0;
      font-size: 9.5pt;
      text-align: right;
    }

    .sheet :global(.cv-proj) {
      margin: 5pt 0 0;
      padding: 0;
      border: 0;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .sheet :global(.cv-proj h3) {
      font-size: 10pt;
      font-weight: 700;
    }

    .sheet :global(.cv-bullets) {
      gap: 1pt;
      margin-top: 3pt;
    }

    .sheet :global(.cv-bullets li) {
      padding-left: 10pt;
    }

    /* Dash as text: browsers leave background colours out of print by default. */
    .sheet :global(.cv-bullets li::before) {
      content: '–';
      top: 0;
      left: 0;
      width: auto;
      height: auto;
      background: none;
    }

    .sheet :global(.cv-tech) {
      margin-top: 2pt;
      font-size: 9.5pt;
      line-height: 1.4;
    }

    .cv-pproj {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .cv-pproj + .cv-pproj {
      margin-top: 8pt;
      padding-top: 0;
      border: 0;
    }

    .cv-pproj-head {
      gap: 6pt;
    }

    .cv-pproj-head h3 {
      font-size: 11pt;
      font-weight: 700;
    }

    .cv-pproj .cv-desc {
      margin-top: 2pt;
      font-size: 10pt;
    }

    /* Status in words inside a thin frame, without the coloured dot. */
    .badge {
      height: auto;
      padding: 0 3pt;
      border: 0.75pt solid var(--text);
      border-radius: 2pt;
      background: none;
      font-size: 9.5pt;
      line-height: 1.3;
      letter-spacing: 0;
    }

    .sheet :global(.cv-skills),
    .sheet :global(.cv-skill) {
      border: 0;
    }

    /* The skills list is never split across two pages. */
    .sheet :global(.cv-skills) {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .sheet :global(.cv-skill) {
      grid-template-columns: 42mm 1fr;
      column-gap: 8pt;
      row-gap: 0;
      padding: 2pt 0;
    }

    .sheet :global(.cv-skill dt) {
      font-size: 10pt;
      font-weight: 700;
    }

    /* Plain text again: "Java (8–21) · SQL · JavaScript", without the line bullets. */
    .sheet :global(.cv-skill dd) {
      display: block;
      font-size: 9.5pt;
      line-height: 1.4;
    }

    .sheet :global(.cv-skill-item) {
      display: inline;
    }

    .print-compact .cv-points {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-print]');
    if (!button) return;
    button.addEventListener('click', () => {
      try {
        window.print();
      } catch (_) {
        // In-app browsers may block the print dialog; the button then does nothing.
      }
    });
  })();
</script>
