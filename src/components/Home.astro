---
import Base from '../layouts/Base.astro';
import ApiView from './ApiView.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import HeroSection from './HeroSection.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHead from './SectionHead.astro';
import SkillsBento from './SkillsBento.astro';
import ContactTerminus from './home/ContactTerminus.astro';
import FocusBands from './home/FocusBands.astro';
import Station3D from './metro/Station3D.astro';
import { profile, shownProjects } from '../data/profile';
import { homeSections } from '../i18n/nav';
import { tr, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const shown = shownProjects();
/** Personal projects as one line under construction: the built stations first, then the planned ones. */
const projectLine = [
  ...shown.filter((project) => project.status !== 'planned'),
  ...shown.filter((project) => project.status === 'planned'),
];
const title = `${profile.name[lang]} — ${profile.role[lang]}`;
---

<Base lang={lang} title={title} description={profile.tagline[lang]} path="/">
  <ApiView lang={lang} />
  <HeroSection lang={lang} />
  {/* The 3D station; data-cam names the shot each block shows while it is in the middle of the window. */}
  {/* At the full level each block is a panel over the left half of the window, the right half with data-panel. */}
  <Station3D lang={lang} />

  <section id="about" class="section" aria-labelledby="about-title" data-cam="start">
    <div class="container">
      <SectionHead lang={lang} id="about-title" title="navAbout" />
      <div class="about-body">
        {profile.about[lang].map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <h3 class="sub-title">{tr('focusTitle', lang)}</h3>
      <FocusBands lang={lang} />
    </div>
  </section>

  {
    homeSections.includes('projects') && (
      <section id="projects" class="section" aria-labelledby="projects-title">
        <div class="container">
          <SectionHead lang={lang} id="projects-title" title="projectsTitle" intro="projectsIntro" neutral />
          <ol class:list={['pj-line', { 'from-planned': projectLine[0]?.status === 'planned' }]}>
            {projectLine.map((project, index) => (
              <ProjectCard project={project} lang={lang} next={projectLine[index + 1]?.status} />
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section id="experience" class="section" aria-labelledby="experience-title" data-panel="right">
    <div class="container">
      <SectionHead lang={lang} id="experience-title" title="experienceTitle" intro="routeIntro" />
      <ExperienceTimeline lang={lang} />
    </div>
  </section>

  <section id="skills" class="section" aria-labelledby="skills-title" data-cam="hubs">
    <div class="container">
      <SectionHead lang={lang} id="skills-title" title="skillsTitle" intro="skillsIntro" />
      <SkillsBento lang={lang} />
    </div>
  </section>

  <section id="contact" class="section last" aria-labelledby="contact-title" data-cam="end">
    <div class="container">
      <ContactTerminus lang={lang} id="contact-title" />
    </div>
  </section>
</Base>

<style>
  /* Blocks keep the global rhythm (.section): more room above a sign than under it. The last one leaves more room
     before the footer. */
  .section.last {
    padding-bottom: 64px;
  }

  .about-body {
    display: grid;
    gap: 16px;
    max-width: 65ch;
    color: var(--muted);
  }

  .about-body p {
    margin: 0;
  }

  .about-body p:first-child {
    font-size: 1.125rem;
    color: var(--text);
  }

  /* "What I work on": a smaller sign inside the About block, above the bands. */
  .sub-title {
    margin: 48px 0 8px;
    font: 700 clamp(1.5rem, 1.25rem + 1vw, 1.875rem) / 1.15 var(--font-display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  /* Projects: personal projects belong to no job, so they make a line of their own, under construction, in the
     neutral line colour, with no route number and no glow. One vertical axis as the Experience route: --rail is the
     centre of the track from the left edge, --pad where the text starts. The line starts at an end bar; the track
     from it to the first station is solid, or dashed 10/8 when that station is planned (ProjectCard.astro draws the
     stations and the track between them). */
  .pj-line {
    --rail: 14px;
    --pad: 44px;
    position: relative;
    margin: 0;
    padding: 28px 0 0;
    list-style: none;
  }

  .pj-line::before {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 3px);
    top: 0;
    width: 6px;
    height: 33px;
    background: var(--line-neutral);
  }

  .pj-line.from-planned::before {
    background: repeating-linear-gradient(to bottom, var(--line-neutral) 0 10px, transparent 10px 18px);
  }

  /* End bar across the start of the track, as the "Now" bar of the route. */
  .pj-line::after {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 14px);
    top: 0;
    width: 28px;
    height: 0;
    border-top: 6px solid var(--line-neutral);
  }

  @media (min-width: 640px) {
    .section.last {
      padding-bottom: 96px;
    }

    .sub-title {
      margin-top: 64px;
    }

    .pj-line {
      --pad: 56px;
    }
  }

  /* Printed: a thin black rule instead of the 6px track, as on the route. */
  @media print {
    .pj-line::before,
    .pj-line.from-planned::before {
      left: calc(var(--rail) - 1px);
      width: 0;
      border-left: 2px solid var(--line-neutral);
      background: none;
    }

    .pj-line.from-planned::before {
      border-left-style: dashed;
    }

    .pj-line::after {
      border-top-width: 2px;
    }
  }
</style>
