---
import { profile, shareImages } from '../data/profile';
import { otherLang } from '../i18n/nav';
import { localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page without the language prefix, e.g. "/resume/". */
  path: string;
  /** Share image under BASE_URL; null or missing falls back to the default share image. */
  ogImage?: string | null;
  ogImageAlt?: string;
  noindex?: boolean;
}

const { lang, title, description, path, ogImage, ogImageAlt, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (file: string) => `${base}/${file}`;
const ogLocale = (value: Lang) => (value === 'vi' ? 'vi_VN' : 'en_US');
const canonical = new URL(localePath(lang, path), Astro.site);
const alternates = [
  { hreflang: 'en', href: new URL(localePath('en', path), Astro.site) },
  { hreflang: 'vi', href: new URL(localePath('vi', path), Astro.site) },
  { hreflang: 'x-default', href: new URL(localePath('en', path), Astro.site) },
];
const imageFile = ogImage ?? shareImages.default[lang];
const image = imageFile ? new URL(asset(imageFile), Astro.site) : undefined;
const imageAlt = ogImageAlt ?? `${profile.name[lang]} — ${profile.role[lang]}`;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
<link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={ogLocale(lang)} />
{!noindex && <meta property="og:locale:alternate" content={ogLocale(otherLang(lang))} />}
{
  image && (
    <>
      <meta property="og:image" content={image} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={imageAlt} />
    </>
  )
}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
