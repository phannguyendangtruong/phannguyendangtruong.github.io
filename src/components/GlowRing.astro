---
interface Props {
  /** Turn the gradient slowly while the parent is hovered (fine pointers only); still otherwise. */
  spin?: boolean;
}

const { spin = false } = Astro.props;
---

<span class:list={['glow-ring', 'no-print', { spin }]} aria-hidden="true"></span>

<style>
  /* Gradient border drawn over the 1px edge of the parent, which needs position: relative and a border radius. */
  .glow-ring {
    position: absolute;
    inset: -1px;
    z-index: 0;
    border-radius: inherit;
    padding: 1px;
    overflow: hidden;
    pointer-events: none;
    background: conic-gradient(from 210deg, var(--accent), var(--accent-2), var(--accent-3), var(--accent));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  /* Same gradient on a square larger than the diagonal, so it covers the edge at any angle. */
  .spin::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(150%, 1200px);
    aspect-ratio: 1;
    background: inherit;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s;
    animation: glow-spin 8s linear infinite paused;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(:hover) > .spin::before {
      opacity: 1;
      animation-play-state: running;
    }
  }

  @keyframes glow-spin {
    from {
      transform: translate(-50%, -50%) rotate(0turn);
    }

    to {
      transform: translate(-50%, -50%) rotate(1turn);
    }
  }
</style>
