---
import { lineByNumber } from '../../data/network';
import type { Lang } from '../../i18n/ui';

interface Props {
  /** Route number of the line. */
  line: number;
  /** Centre of the route bullet in the units of the parent SVG; the company and the start year follow on its right. */
  x: number;
  y: number;
  lang: Lang;
}

const { line, x, y, lang } = Astro.props;
const route = lineByNumber(line);
const year = route.job.start.split('/')[1];
---

<g class="nm-start" style={`--line: ${route.color}`}>
  <circle class="nm-bullet" cx={x} cy={y} r="10" />
  <text class="nm-bullet-n" x={x} y={y + 4.5} text-anchor="middle">{route.number}</text>
  <text class="nm-start-text" x={x + 16} y={y + 5}><tspan class="nm-company">{route.job.company[lang]}</tspan><tspan class="nm-year" dx="6">{year}</tspan></text>
</g>
