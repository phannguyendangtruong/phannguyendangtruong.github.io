---
import { lineByNumber } from '../../data/network';

interface Props {
  /** Centre in the units of the parent SVG. */
  x: number;
  y: number;
  /** Route number of the line the station is on. */
  line: number;
  /** Radius; the ring is 3 units wide. */
  r?: number;
  class?: string;
}

const { x, y, line, r = 7, class: className } = Astro.props;
---

<circle class:list={['station', className]} cx={x} cy={y} r={r} style={`--line: ${lineByNumber(line).color}`} />

<style>
  /* SVG element for a parent <svg>: a ring in the line colour on the page background. */
  .station {
    fill: var(--bg);
    stroke: var(--line);
    stroke-width: 3;
  }
</style>
