---
import { lineByNumber } from '../../data/network';

interface Props {
  /** End of the track, in the units of the parent SVG. */
  x: number;
  y: number;
  /** Route number of the line that ends here. */
  line: number;
  /** Direction of the track that ends here; the bar is drawn across it. */
  track?: 'x' | 'y';
  /** Length of the bar. */
  length?: number;
  /** Thickness of the bar. */
  width?: number;
  class?: string;
}

const { x, y, line, track = 'x', length = 18, width = 6, class: className } = Astro.props;
const half = length / 2;
const [x1, y1, x2, y2] = track === 'x' ? [x, y - half, x, y + half] : [x - half, y, x + half, y];
---

<line
  class:list={['terminal', className]}
  x1={x1}
  y1={y1}
  x2={x2}
  y2={y2}
  stroke-width={width}
  style={`--line: ${lineByNumber(line).color}`}
/>

<style>
  /* SVG element for a parent <svg>: the bar that closes the end of a line. */
  .terminal {
    stroke: var(--line);
    stroke-linecap: butt;
  }
</style>
