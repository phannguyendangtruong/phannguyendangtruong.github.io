---
import Station3DNarrow from './Station3DNarrow.astro';
import Station3DTags from './Station3DTags.astro';
import { buildSceneModel } from '../../scripts/station3d/model';
import { tr, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
/** The network of the hero map as a night city in 3D, from the same data (src/scripts/station3d/). */
const model = buildSceneModel(lang);
/**
 * Media queries of the run levels (src/scripts/station3d/level.ts): off under reduced motion. The full level runs on
 * any window: platform panels from 1024px wide, cards stacked over the scene under that (the narrow query). Save-Data,
 * a missing WebGL 2, a weak device and a full level that already ran too slowly in this session are tested by the
 * scripts.
 */
const offQuery = '(prefers-reduced-motion: reduce)';
const narrowQuery = '(max-width: 1023px)';
---

<div
  class="s3d no-print"
  data-s3d
  data-model={JSON.stringify(model)}
  data-off-query={offQuery}
  data-narrow-query={narrowQuery}
  aria-hidden="true"
  hidden
>
</div>
<div class="s3d-labels no-print" data-s3d-labels role="group" aria-label={tr('mapLinks', lang)} hidden></div>
<Station3DNarrow />
<Station3DTags />

<script is:inline>
  // Run before the blocks under the hero are drawn: the full level sets them out over the scene (platform panels on a
  // wide window, stacked cards on a narrow one), so the layout is fixed now and does not shift when the scene comes in
  // after the page has loaded. The same tests as level.ts: WebGL 2 on a real GPU is tried for real (a software
  // renderer fails it, so the level is never set and then dropped), its test context is given back at once and the
  // result is kept in data-webgl2 for level.ts; then less than 4 GB of memory or fewer than 4 cores, or a full level
  // that already ran too slowly in this session, take the lite level.
  (() => {
    const host = document.querySelector('[data-s3d]');
    const connection = navigator.connection;
    if (!host || (connection && connection.saveData)) return;
    if (matchMedia(host.dataset.offQuery).matches) return;
    let webgl = false;
    try {
      const gl = document.createElement('canvas').getContext('webgl2', { failIfMajorPerformanceCaveat: true });
      webgl = gl !== null;
      const lose = gl && gl.getExtension('WEBGL_lose_context');
      if (lose) lose.loseContext();
    } catch (_) {}
    host.dataset.webgl2 = webgl ? 'yes' : 'no';
    if (!webgl) return;
    const memory = navigator.deviceMemory;
    const cores = navigator.hardwareConcurrency;
    let lite = (memory > 0 && memory < 4) || (cores > 0 && cores < 4);
    try {
      lite = lite || sessionStorage.getItem('s3d-lite') === '1';
    } catch (_) {}
    document.documentElement.dataset.scene3d = lite ? 'lite' : 'full';
  })();
</script>

<script>
  import { boot } from '../../scripts/station3d/index';

  boot();
</script>

<style>
  /* Both layers keep the hidden attribute until a level starts the scene: at the off level the page is exactly the
     page without it. */
  .s3d,
  .s3d-labels {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  /* Full level: the canvas behind the whole home page, under every block, fading in once its first frame is drawn.
     The labels sit above the open page background and under the platform panels; the scene fades out a label as it
     comes up to a panel, so none is cut at the edge of one. The labels and the pointer card are styled in
     Station3DTags.astro. */
  .s3d {
    z-index: -1;
    opacity: 0;
    transition: opacity 600ms var(--ease);
  }

  .s3d.is-ready {
    opacity: 1;
  }

  .s3d :global(canvas) {
    display: block;
  }

  .s3d-labels {
    z-index: 0;
  }

  /* Under 1024px the canvas keeps the height of the window with the browser bars folded away (100vh), so a phone does
     not draw it again at another size each time it shows or hides them while the page scrolls. */
  @media (max-width: 1023px) {
    :global(html[data-scene3d='full']) .s3d {
      bottom: auto;
      height: 100vh;
    }
  }

  /* Lite level: both layers fill the hero map box, under its pause button. The canvas sits in a frame of 16px
     corners and a 1px rule; the labels layer lies inside the rule, over the canvas. */
  .s3d[data-level='lite'],
  .s3d-labels[data-level='lite'] {
    position: absolute;
    z-index: auto;
  }

  .s3d[data-level='lite'] {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .s3d-labels[data-level='lite'] {
    inset: 1px;
  }

  /* Under 1024px the lite level makes the hero map box square, for its shot of the trunk and the end
     (src/scripts/station3d/camera.ts); the wide map from 1024px keeps its own shape. */
  :global(html[data-scene3d='lite'] .netmap) {
    aspect-ratio: 1;
  }

  @media (min-width: 1024px) {
    :global(html[data-scene3d='lite'] .netmap) {
      aspect-ratio: auto;
    }
  }

  /* The hero map under the scene (NetworkMap.astro), once the first frame is drawn: its drawing fades out but stays
     for screen readers, its link labels and packets give way to the scene, and its pause button stays above the
     scene, where it now stops the trains and every other motion. */
  :global(.netmap .nm-view) {
    transition: opacity 600ms var(--ease);
  }

  :global(.netmap.is-3d .nm-view) {
    opacity: 0;
    pointer-events: none;
  }

  :global(.netmap.is-3d .nm-links) {
    visibility: hidden;
  }

  :global(.netmap.is-3d .nm-packets) {
    display: none;
  }

  :global(.netmap.is-3d .nm-pause) {
    z-index: 1;
  }

  /* Full level (html[data-scene3d='full'], set before these blocks are drawn): the footer covers the scene. From
     1024px wide each home block after the hero is a platform panel over one half of the window, on the left or, for a
     block marked data-panel="right", on the right. The other half is left to the scene, which frames each shot there
     (src/scripts/station3d/panels.ts). Under 1024px the blocks are cards stacked over the scene
     (Station3DNarrow.astro). */
  @media screen {
    :global(html[data-scene3d='full'] .site-footer) {
      position: relative;
      z-index: 1;
      background: var(--bg);
    }
  }

  @media screen and (min-width: 1024px) {
    /* The hero stays open over the city: a soft patch of the page background lies behind its name block, blurred so
       it fades out on every side without an edge and is gone before the foot of the hero. Its body reaches 72px or
       more past the text all round, so the text, the link line under the buttons included, keeps 4.5:1 or more over
       the lit city in both themes. The block is 400px wide, 24px in from the start of the page container, and its
       text runs from 56px to about 485px under the top of the hero (HeroSection.astro). */
    :global(html[data-scene3d='full'] .hero) {
      position: relative;
    }

    :global(html[data-scene3d='full'] .hero::before) {
      content: '';
      position: absolute;
      top: -16px;
      left: calc(max(0px, (100% - var(--max)) / 2) + 24px - 72px);
      width: 544px;
      height: 576px;
      border-radius: 80px;
      pointer-events: none;
      background: color-mix(in srgb, var(--bg) 86%, transparent);
      filter: blur(32px);
    }

    /* 34vh of open scene between two panels: this margin and the 56px paddings of both sections (.section). */
    :global(html[data-scene3d='full'] main > section.section) {
      margin-top: max(16px, 34vh - 112px);
    }

    /* About half the window wide, the outer edge of the panel on the edge of the page container, as the header and
       footer: 24px from the window edge until the window is wider than the container (--max), then where the
       container starts. A right panel mirrors this on the right. */
    :global(html[data-scene3d='full'] main > section.section > .container) {
      --panel-width: min(720px, 52%);
      --panel-edge: max(24px, (100% - var(--max)) / 2);
      position: relative;
      z-index: 1;
      width: var(--panel-width);
      max-width: none;
      margin: 0 auto 0 var(--panel-edge);
      padding: 36px 32px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: color-mix(in srgb, var(--bg) 86%, transparent);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }

    :global(html[data-scene3d='full'] main > section.section[data-panel='right'] > .container) {
      margin: 0 var(--panel-edge) 0 auto;
    }
  }
</style>
