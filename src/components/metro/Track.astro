---
import { checkTrack, lineColor } from '../../data/network';

interface Props {
  /**
   * Route number of the line; without it the track takes the neutral colour of diagrams that belong to no job. A
   * track with a line glows in the dark theme (.led in src/styles/global.css).
   */
  line?: number;
  /** Points in order, in the units of the parent SVG; every segment is horizontal, vertical or at 45°. */
  points: [number, number][];
  /** Thickness of the track. */
  width?: number;
  /** Dashed: a section that is not built. */
  dashed?: boolean;
  class?: string;
}

const { line, points, width = 7, dashed = false, class: className } = Astro.props;
checkTrack(points, line === undefined ? 'đường trung tính' : `tuyến ${line}`);
const d = points.map(([x, y], index) => `${index === 0 ? 'M' : 'L'}${x} ${y}`).join('');
---

<path
  class:list={['track', { dashed, led: line !== undefined }, className]}
  d={d}
  stroke-width={width}
  style={`--line: ${lineColor(line)}`}
/>

<style>
  /* SVG element for a parent <svg>: a line of the map, with rounded bends. */
  .track {
    fill: none;
    stroke: var(--line);
    stroke-linejoin: round;
    stroke-linecap: butt;
  }

  .dashed {
    stroke-dasharray: 10 8;
  }
</style>
