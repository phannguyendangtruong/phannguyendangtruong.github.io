---
import { checkTrack, lineByNumber } from '../../data/network';

interface Props {
  /** Route number of the line. */
  line: number;
  /** Points in order, in the units of the parent SVG; every segment is horizontal, vertical or at 45°. */
  points: [number, number][];
  /** Thickness of the track. */
  width?: number;
  /** Dashed: a section that is not built. */
  dashed?: boolean;
  class?: string;
}

const { line, points, width = 7, dashed = false, class: className } = Astro.props;
checkTrack(points, `tuyến ${line}`);
const d = points.map(([x, y], index) => `${index === 0 ? 'M' : 'L'}${x} ${y}`).join('');
---

<path
  class:list={['track', { dashed }, className]}
  d={d}
  stroke-width={width}
  style={`--line: ${lineByNumber(line).color}`}
/>

<style>
  /* SVG element for a parent <svg>: a line of the map, with rounded bends. */
  .track {
    fill: none;
    stroke: var(--line);
    stroke-linejoin: round;
    stroke-linecap: butt;
  }

  .dashed {
    stroke-dasharray: 10 8;
  }
</style>
