---
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import { statusLabel, type Project, type ProjectStatus } from '../data/profile';
import { caseStudyProjects } from '../i18n/nav';
import { localePath, tr, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  /** Status of the next station down the line, which the track under this one runs to; none on the last station. */
  next?: ProjectStatus;
}

const { project, lang, next } = Astro.props;
const points = project.points?.[lang] ?? [];
const arch = project.arch ?? [];
const archId = `${(project.slug ?? project.name).toLowerCase().replace(/[^a-z0-9]+/g, '-')}-arch`;
const hasCaseStudy = caseStudyProjects().some((item) => item.slug === project.slug);
const caseStudy = hasCaseStudy ? localePath(lang, `/projects/${project.slug}/`) : undefined;
const repoSoon = project.status === 'in-progress' && !project.repoUrl;
const linked = Boolean(caseStudy || project.demoUrl || project.repoUrl || repoSoon);
---

<li class:list={['pj-stop', { 'to-planned': next === 'planned', last: next === undefined }]}>
  <div class="pj-head">
    <h3 class="pj-name">{project.name}</h3>
    <span class:list={['badge', project.status]}>{tr(statusLabel[project.status], lang)}</span>
  </div>
  <p class="pj-sum">{project.summary[lang]}</p>
  {
    points.length > 0 && (
      <ul class="dash-list pj-points">
        {points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )
  }
  {
    arch.length > 0 && (
      <div class="pj-arch">
        <p class="caps-label" id={archId} aria-hidden="true">
          {tr('projectArch', lang)}
        </p>
        <ol class="pj-arch-list" aria-labelledby={archId}>
          {arch.map((item, index) => (
            <li>
              {index > 0 && <Icon name="arrow-right" size={12} />}
              <span class="pj-part">{item}</span>
            </li>
          ))}
        </ol>
      </div>
    )
  }
  <ul class="tags pj-tags" aria-label={tr('techLabel', lang)}>
    {project.tech.map((item) => <li>{item}</li>)}
  </ul>
  {
    linked && (
      <div class="pj-links">
        {caseStudy && (
          <a class="text-link accent" href={caseStudy}>
            {tr('readCaseStudy', lang)}
            <span class="sr-only">{` ${project.name}`}</span>
            <Icon name="arrow-right" size={16} />
          </a>
        )}
        {project.demoUrl && <ExternalLink href={project.demoUrl} lang={lang} label={tr('demo', lang)} class="text-link" />}
        {project.repoUrl && (
          <ExternalLink href={project.repoUrl} lang={lang} label={tr('repository', lang)} class="text-link" />
        )}
        {repoSoon && <span class="pj-soon faint">{tr('repoSoon', lang)}</span>}
      </div>
    )
  }
</li>

<style>
  /* A project is a station of the projects line: a ring on the rail, with its name, status, summary, points,
     technologies and links beside it as on the route; no card round it (--rail and --pad come from the line in
     Home.astro). */
  .pj-stop {
    position: relative;
    padding: 0 0 40px var(--pad);
  }

  .pj-stop.last {
    padding-bottom: 0;
  }

  /* The track from this station down to the next one, in the neutral line colour, with no glow: solid, or dashed 10/8
     when it runs to a planned station (an unbuilt section). Hard stops, so a dash pattern rather than a gradient. */
  .pj-stop::before {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 3px);
    top: 13px;
    bottom: -13px;
    width: 6px;
    background: var(--line-neutral);
  }

  .pj-stop.to-planned::before {
    background: repeating-linear-gradient(to bottom, var(--line-neutral) 0 10px, transparent 10px 18px);
  }

  .pj-stop.last::before {
    content: none;
  }

  /* Station ring on the page background, centred on the first line of the name; the next station's ring covers the
     end of the track above it. */
  .pj-stop::after {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 8px);
    top: 5px;
    width: 16px;
    height: 16px;
    border: 3px solid var(--line-neutral);
    border-radius: 50%;
    background: var(--bg);
  }

  /* Name and status chip on one row, the chip under the name when the row is too narrow. */
  .pj-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }

  .pj-name {
    margin: 0;
    font: 600 1.375rem/1.2 var(--font);
  }

  .pj-sum {
    max-width: 70ch;
    margin: 8px 0 0;
    color: var(--muted);
  }

  .dash-list.pj-points {
    max-width: 70ch;
    margin-top: 12px;
  }

  /* Main parts of the system in order: names of code, so the mono face, joined by arrows. */
  .pj-arch {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }

  .pj-arch .caps-label {
    margin: 0;
  }

  .pj-arch-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pj-arch-list li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .pj-arch-list :global(svg) {
    flex: none;
    width: 12px;
    height: 12px;
    color: var(--muted);
  }

  .pj-part {
    font: 500 0.8125rem/1.4 var(--mono);
    color: var(--text);
  }

  /* Technologies: 32px capsules in the mono face, as the chips of the route, but not buttons. */
  .tags.pj-tags {
    gap: 12px 8px;
    margin-top: 16px;
  }

  .tags.pj-tags li {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
  }

  .pj-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
    margin-top: 8px;
  }

  .pj-soon {
    font-size: 0.8125rem;
  }

  /* Printed: a thin black rule instead of the 6px track, dashed towards a planned station. */
  @media print {
    .pj-stop {
      break-inside: avoid;
    }

    .pj-stop::before,
    .pj-stop.to-planned::before {
      left: calc(var(--rail) - 1px);
      width: 0;
      border-left: 2px solid var(--line-neutral);
      background: none;
    }

    .pj-stop.to-planned::before {
      border-left-style: dashed;
    }
  }
</style>
