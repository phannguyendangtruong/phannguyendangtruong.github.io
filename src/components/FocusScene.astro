---
import Interchange from './metro/Interchange.astro';
import Station from './metro/Station.astro';
import Terminal from './metro/Terminal.astro';
import Track from './metro/Track.astro';
import { focusScenes, type FocusScene, type FocusSceneStops } from '../data/hero';

interface Props {
  kind: FocusScene;
}

type Point = [number, number];
type Stop = { x: number; name: string; anchor: 'start' | 'middle' | 'end'; lx: number };

const { kind } = Astro.props;
/** viewBox of every diagram; the line runs from x = 20 to x = 380. */
const width = 400;
const height = 100;
const left = 20;
const right = 380;
const scene: FocusSceneStops = focusScenes[kind];
/** Height of the line, and of the labels: above it when a loop runs below (workflow), below it otherwise. */
const y = { ingest: 46, workflow: 36, security: 62 }[kind];
const labelY = scene.branch ? y - 16 : y + 26;

/** Stops spread evenly along the line; the first and last labels line up with the ends of the line. */
const stops = scene.stops.map((name, index, all): Stop => {
  const x = Math.round(left + (index * (right - left)) / Math.max(1, all.length - 1));
  if (index === 0) return { x, name, anchor: 'start', lx: x - 6 };
  if (index === all.length - 1) return { x, name, anchor: 'end', lx: x + 6 };
  return { x, name, anchor: 'middle', lx: x };
});
const first = stops[0];
const second = stops[1];
const last = stops[stops.length - 1];
const main: Point[] = [
  [first.x, y],
  [last.x, y],
];

/** Workflow: a loop from the second stop down, back along the bottom and up into the first, with a station on it. */
const depth = 30;
const loop: Point[] | undefined =
  scene.branch && second
    ? [
        [second.x, y],
        [second.x - depth, y + depth],
        [first.x + depth, y + depth],
        [first.x, y],
      ]
    : undefined;
const branchX = second ? Math.round((first.x + second.x) / 2) : first.x;

/** Security: a short spur up from the second stop, closed by a bar, with its label on the right. */
const spurTop = 26;
const spur: Point[] | undefined =
  scene.spur && second
    ? [
        [second.x, y],
        [second.x, spurTop],
      ]
    : undefined;

/** Stops between the ends; the second is an interchange round stop when a loop or a spur leaves from it. */
const joined = Boolean(loop || spur);
const middle = stops.slice(1, -1).filter((stop) => !(joined && stop === second));
---

<svg
  class:list={['scene', `scene-${kind}`, 'no-print']}
  viewBox={`0 0 ${width} ${height}`}
  aria-hidden="true"
  focusable="false"
>
  <Track points={main} />
  {loop && <Track points={loop} />}
  {spur && <Track points={spur} />}
  <Terminal x={first.x} y={y} />
  <Terminal x={last.x} y={y} />
  {spur && <Terminal x={spur[1][0]} y={spur[1][1]} track="y" />}
  {middle.map((stop) => <Station x={stop.x} y={y} />)}
  {joined && second && <Interchange x={second.x} y={y} tracks={1} />}
  {loop && <Station x={branchX} y={y + depth} />}
  {stops.map((stop) => <text class="fs-label" x={stop.lx} y={labelY} text-anchor={stop.anchor}>{stop.name}</text>)}
  {loop && scene.branch && <text class="fs-label" x={branchX} y={y + depth + 24} text-anchor="middle">{scene.branch}</text>}
  {spur && scene.spur && <text class="fs-label" x={spur[1][0] + 18} y={spurTop + 5}>{scene.spur}</text>}
</svg>

<style>
  /* Static diagram in the grammar of the map: a line, its stations, its end bars, in the neutral colour since it
     belongs to no job. It takes the width it is given, up to 480px; the labels are station signs in the condensed
     face, written as the data gives them. */
  .scene {
    display: block;
    width: 100%;
    max-width: 480px;
    height: auto;
    overflow: visible;
  }

  /* Font sizes are viewBox units: larger on phones, where the diagram is drawn smaller. */
  .fs-label {
    font: 600 16px var(--font-display);
    letter-spacing: 0.04em;
    fill: var(--text);
  }

  @media (min-width: 640px) {
    .fs-label {
      font-size: 13px;
    }
  }
</style>
