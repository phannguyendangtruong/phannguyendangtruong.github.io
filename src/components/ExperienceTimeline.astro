---
import RouteBullet from './metro/RouteBullet.astro';
import RouteStop from './home/RouteStop.astro';
import SkillFilter from './home/SkillFilter.astro';
import { lineOfJob } from '../data/network';
import { education, experienceNewestFirst, isCurrentJob } from '../data/profile';
import { formatPeriod, tr, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
/** Newest company first: each one is a leg of its own line, the current one runs up to the "Now" station. */
const legs = experienceNewestFirst().map((job) => ({ job, line: lineOfJob(job), current: isCurrentJob(job) }));
const educationLine = [education.major?.[lang], education.period?.[lang]].filter(Boolean).join(' · ');
---

<SkillFilter lang={lang} />
<div class="route" data-timeline>
  <ol class="legs">
    {
      legs.map(({ job, line, current }) => (
        <li class:list={['leg', 'tl-item', { current }]} style={`--line: ${line.color}`}>
          {current && (
            <p class="leg-now">
              <span class="now-bar" aria-hidden="true" />
              {tr('mapNow', lang)}
            </p>
          )}
          <div class="leg-head tl-head">
            <RouteBullet line={line.number} class="leg-bullet" />
            <div>
              <h3 class="leg-company">{job.company[lang]}</h3>
              <p class="leg-role">{job.role[lang]}</p>
            </div>
            <p class="leg-period">{formatPeriod(job.start, job.end, lang)}</p>
          </div>
          <ol class="stops">
            {job.projects.map((project) => (
              <RouteStop project={project} lang={lang} />
            ))}
          </ol>
        </li>
      ))
    }
  </ol>
  <div class="origin">
    <h3 class="leg-company">{education.school[lang]}</h3>
    <p class="leg-role">{tr('educationTitle', lang)}</p>
    {educationLine && <p class="origin-line">{educationLine}</p>}
  </div>
</div>

<style>
  /* One vertical axis: --rail is the centre of the track from the left edge, --pad where the text starts. */
  .route {
    --rail: 14px;
    --pad: 44px;
  }

  .legs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A company is a stretch of its line: a 6px track in the line colour down the whole block. */
  .leg {
    position: relative;
    padding: 0 0 40px var(--pad);
  }

  .leg::before {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 3px);
    top: 0;
    bottom: 0;
    width: 6px;
    background: var(--line);
  }

  /* The current stretch starts at the "Now" station: an end bar across the track. */
  .leg.current::before {
    top: 10px;
  }

  /* The last stretch reaches under the ring of the education station. */
  .leg:last-child::before {
    bottom: -8px;
  }

  .leg-now {
    position: relative;
    margin: 0 0 20px;
    font: 700 1rem/20px var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .now-bar {
    position: absolute;
    left: calc(var(--rail) - var(--pad) - 14px);
    top: 7px;
    width: 28px;
    height: 6px;
    background: var(--line);
  }

  /* Company row: the route bullet sits on the track, centred on the first line of the name. */
  .leg-head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    margin-bottom: 20px;
  }

  .leg-head :global(.leg-bullet) {
    position: absolute;
    left: calc(var(--rail) - var(--pad) - 14px);
    top: -1px;
  }

  /* Station name: the company of a leg, or the school of the education station. */
  .leg-company {
    margin: 0;
    font: 600 1.375rem/1.2 var(--font);
  }

  /* Line under the station name: the role, or "Education". */
  .leg-role {
    margin: 2px 0 0;
    color: var(--muted);
  }

  .leg-period {
    margin: 0;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    white-space: nowrap;
  }

  .stops {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Where the route starts: education, a station like a company (school as its name, "Education" under it), with a
     ring in the text colour at the bottom of the track, centred on the first line of the name. */
  .origin {
    position: relative;
    padding-left: var(--pad);
  }

  .origin::before {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 9px);
    top: 4px;
    width: 18px;
    height: 18px;
    border: 3px solid var(--text);
    border-radius: 50%;
    background: var(--bg);
  }

  .origin-line {
    margin: 2px 0 0;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .route {
      --pad: 56px;
    }

    .leg {
      padding-bottom: 48px;
    }
  }

  /* Printed: a thin black rule instead of the coloured track. */
  @media print {
    .leg::before {
      width: 2px;
      left: calc(var(--rail) - 1px);
    }
  }
</style>
