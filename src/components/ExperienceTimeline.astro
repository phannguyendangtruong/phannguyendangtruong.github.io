---
import { experienceNewestFirst, isCurrentJob } from '../data/profile';
import { formatPeriod, tr, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const jobs = experienceNewestFirst();
/** Bullet lists of at least this many lines use two columns on wide screens. */
const twoColumnFrom = 6;
---

<div class="tl-wrap" data-timeline>
  <div class="tl-rail" aria-hidden="true"><span class="tl-fill"></span><span class="tl-spark"></span></div>
  <ol class="timeline">
    {
      jobs.map((job) => (
        <li class:list={['tl-item', { current: isCurrentJob(job) }, 'reveal']}>
          <span class="tl-dot" aria-hidden="true"></span>
          <div class="card spot tl-card">
            <span class="tl-glow" aria-hidden="true"></span>
            <div class="tl-head">
              <div>
                <h3 class="tl-company">{job.company[lang]}</h3>
                <p class="tl-role">{job.role[lang]}</p>
              </div>
              <p class="tl-period">{formatPeriod(job.start, job.end, lang)}</p>
            </div>
            {job.projects.map((project) => (
              <div class="tl-proj">
                <h4>{project.name[lang]}</h4>
                {project.subsystems && <p class="tl-sub">{project.subsystems[lang]}</p>}
                <p class="tl-sum">{project.summary[lang]}</p>
                {project.bullets && project.bullets[lang].length > 0 && (
                  <ul class:list={['dash-list', 'tl-bullets', { 'two-col': project.bullets[lang].length >= twoColumnFrom }]}>
                    {project.bullets[lang].map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
                <ul class="tags tl-tags" aria-label={tr('techLabel', lang)} data-fx>
                  {project.tech.map((item, position) => (
                    <li style={`--i: ${position}`}>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* Phone: the rail sits in a 12px column on the left edge, the cards start 12px after it. */
  .tl-wrap {
    --rail-x: 5px;
    --dot: 12px;
    --dot-top: 23px;
    position: relative;
  }

  .tl-rail {
    position: absolute;
    left: var(--rail-x);
    top: calc(var(--dot-top) + var(--dot) / 2);
    bottom: 24px;
    width: 2px;
    border-radius: 2px;
    background: var(--border);
  }

  /* Filled part of the rail; the script scales it with the scroll position, otherwise it is full. */
  .tl-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--grad-rail);
    box-shadow: 0 0 10px var(--glow);
    transform-origin: top;
    transform: scaleY(var(--tl-progress, 1));
  }

  /* Glowing packet at the head of the filled part: a box as tall as the rail, moved up by the part still to fill,
     with the packet on its bottom edge. Only shown while the script follows the scroll. */
  .tl-spark {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(calc((var(--tl-progress, 1) - 1) * 100%));
    pointer-events: none;
  }

  .tl-spark::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 8px;
    height: 8px;
    margin: 0 0 -4px -4px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 6px 1px var(--accent-2), 0 0 16px var(--glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tl-wrap.scrub .tl-spark {
      opacity: 1;
      transition: opacity 0.3s;
    }
  }

  .timeline {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl-item {
    position: relative;
    padding-left: calc(var(--dot) + 12px);
  }

  .tl-dot {
    position: absolute;
    left: calc(var(--rail-x) + 1px - var(--dot) / 2);
    top: var(--dot-top);
    z-index: 1;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px var(--chip-bg), 0 0 14px var(--glow);
    transition: background-color 0.3s, border-color 0.3s, box-shadow 0.3s;
  }

  .current .tl-dot {
    background: var(--ok);
    border-color: var(--ok);
    box-shadow: 0 0 0 5px var(--ok-soft), 0 0 16px var(--ok);
  }

  /* Not reached yet by the filled rail. */
  .tl-wrap.scrub .tl-item:not(.reached) .tl-dot {
    background: var(--bg);
    border-color: var(--border-strong);
    box-shadow: 0 0 0 4px var(--chip-bg);
  }

  .current .tl-dot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--ok);
    opacity: 0;
  }

  .tl-wrap.lit .current .tl-dot::after {
    animation: tl-beat 1.4s ease-out 3;
  }

  /* One pulse when the filled rail first reaches a company (.hit, set by the script). */
  .tl-dot::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent-2);
    opacity: 0;
  }

  .tl-card {
    padding: 16px;
  }

  .current .tl-card {
    box-shadow: 0 0 0 1px var(--ok-soft), 0 24px 56px -40px var(--ok);
  }

  /* Light edge of the card at the same moment; it fades out again. */
  .tl-glow {
    position: absolute;
    inset: -1px;
    z-index: 0;
    border-radius: inherit;
    border: 1px solid var(--accent-2);
    box-shadow: 0 0 24px -6px var(--accent-2);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hit .tl-dot::before {
      animation: tl-beat 1.2s ease-out 1;
    }

    .hit .tl-glow {
      animation: tl-glow 1.8s ease-out 1;
    }
  }

  .tl-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px 16px;
    margin-bottom: 14px;
  }

  .tl-company {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .tl-role {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--muted);
  }

  .tl-period {
    margin: 0;
    padding: 5px 12px;
    border: 1px solid var(--chip-border);
    border-radius: var(--radius-pill);
    background: var(--chip-bg);
    font: 12.5px/1.5 var(--mono);
    color: var(--muted);
    white-space: nowrap;
  }

  .current .tl-period {
    color: var(--text);
    border-color: var(--ok);
    background: var(--ok-soft);
  }

  /* Phone: projects are separated by a line inside the company card, not framed again. */
  .tl-proj {
    display: grid;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .tl-proj + .tl-proj {
    margin-top: 16px;
  }

  .tl-proj h4 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .tl-proj p {
    margin: 0;
  }

  .tl-sub {
    font: 12.5px/1.5 var(--mono);
    color: var(--accent);
  }

  .tl-sum {
    max-width: 78ch;
    font-size: 15px;
    color: var(--muted);
  }

  .tl-bullets {
    font-size: 15px;
  }

  .tl-proj .tags {
    gap: 6px;
  }

  .tl-proj .tags li {
    padding: 6px 9px;
    font-size: 11.5px;
  }

  /* Technology chips come in one after another when the list comes on screen (SiteScripts: .fx-wait, then .fx-run). */
  @media screen and (prefers-reduced-motion: no-preference) {
    .tl-tags.fx-wait li {
      opacity: 0;
    }

    .tl-tags.fx-run li {
      animation: tl-chip 0.42s var(--ease) calc(var(--i, 0) * 45ms) 1 both;
      animation-play-state: paused;
    }

    .tl-tags.fx-run.fx-on li {
      animation-play-state: running;
    }
  }

  @media (min-width: 640px) {
    .tl-wrap {
      --rail-x: 11px;
      --dot: 16px;
      --dot-top: 32px;
    }

    .timeline {
      gap: 28px;
    }

    .tl-item {
      padding-left: calc(var(--rail-x) + 29px);
    }

    .tl-card {
      padding: 24px;
    }

    .tl-company {
      font-size: clamp(26px, 3vw, 32px);
    }

    .tl-proj {
      padding: 20px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--surface-2);
    }

    .tl-proj + .tl-proj {
      margin-top: 12px;
    }

    .tl-proj .tags {
      gap: 8px;
    }

    .tl-proj .tags li {
      padding: 7px 10px;
      font-size: 12px;
    }
  }

  /* Read the left column first, then the right one. */
  @media (min-width: 1024px) {
    .tl-wrap {
      --dot-top: 37px;
    }

    .tl-card {
      padding: 28px;
    }

    .two-col {
      display: block;
      columns: 2;
      column-gap: 32px;
    }

    .two-col li {
      break-inside: avoid;
      margin-bottom: 8px;
    }
  }

  @keyframes tl-beat {
    from {
      transform: scale(1);
      opacity: 0.75;
    }

    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes tl-glow {
    0% {
      opacity: 0;
    }

    20% {
      opacity: 0.9;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes tl-chip {
    from {
      opacity: 0;
      transform: translateY(6px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const wrap = document.querySelector('[data-timeline]');
    if (!wrap) return;
    const rm = matchMedia('(prefers-reduced-motion: reduce)');
    const hasObserver = 'IntersectionObserver' in window;
    const rail = wrap.querySelector('.tl-rail');
    const items = Array.from(wrap.querySelectorAll('.tl-item'));

    // The rail fills with the gradient as the list passes 60% of the window height; dots light up once reached.
    // A packet rides the head of the filled part (CSS, from --tl-progress). The first time the list on screen reaches
    // a company, its dot pulses and its card edge lights up once (.hit).
    // Reduced motion or no script: the rail stays full and every dot lit, without packet or pulse.
    let frame = 0;
    let listening = false;
    let visible = !hasObserver;
    const update = () => {
      frame = 0;
      if (!rail || rm.matches) return;
      const box = rail.getBoundingClientRect();
      const line = innerHeight * 0.6;
      const progress = box.height > 0 ? Math.min(1, Math.max(0, (line - box.top) / box.height)) : 1;
      wrap.style.setProperty('--tl-progress', progress.toFixed(4));
      items.forEach((item) => {
        const dot = item.querySelector('.tl-dot');
        if (!dot) return;
        const rect = dot.getBoundingClientRect();
        const reached = rect.top + rect.height / 2 <= line;
        item.classList.toggle('reached', reached);
        if (reached && visible && !document.hidden) item.classList.add('hit');
      });
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const listen = (on) => {
      if (on === listening) return;
      listening = on;
      if (on) {
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('resize', schedule);
      } else {
        removeEventListener('scroll', schedule);
        removeEventListener('resize', schedule);
      }
    };
    const start = () => {
      wrap.classList.add('scrub');
      update();
      listen(visible);
    };
    const stop = () => {
      listen(false);
      cancelAnimationFrame(frame);
      frame = 0;
      wrap.classList.remove('scrub');
      wrap.style.removeProperty('--tl-progress');
      items.forEach((item) => item.classList.remove('reached', 'hit'));
    };
    if (hasObserver) {
      // Follow the scroll only while the list is on screen; one last update settles it when it leaves.
      new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (rm.matches) return;
        listen(visible);
        schedule();
      }).observe(wrap);

      // Up to three beats on the current job, the first time the list shows.
      const beat = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          beat.disconnect();
          if (!rm.matches) wrap.classList.add('lit');
        },
        { threshold: 0.15 },
      );
      beat.observe(wrap);
    }
    if (!rm.matches) start();
    rm.addEventListener('change', () => {
      if (rm.matches) stop();
      else start();
    });
  })();
</script>
