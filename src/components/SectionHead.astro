---
import { lineByNumber, lineColor, lines as networkLines } from '../data/network';
import { tr, type Lang, type Text, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Id of the heading, referenced by aria-labelledby of the section. */
  id: string;
  /** Label key, or text from a data file (case study lifecycle title). */
  title: UiKey | Text;
  intro?: UiKey;
  /**
   * Route numbers of the lines the section is about, drawn as the colour band under the sign; all lines by default.
   * The band always reads in route order (1, 2, 3), whatever the order given.
   */
  lines?: number[];
  /** A section that belongs to no job: the band is one stretch in the neutral line colour, and `lines` is ignored. */
  neutral?: boolean;
  /** @deprecated Ignored: section heads have no label above the heading any more. */
  label?: UiKey;
  /** @deprecated Ignored: section heads have no block number any more. */
  mark?: string;
  /** @deprecated Ignored: section heads are always shown, without a fade. */
  reveal?: boolean;
  class?: string;
}

const {
  lang,
  id,
  title,
  intro,
  lines = networkLines.map((line) => line.number),
  neutral = false,
  class: className,
} = Astro.props;
const heading = typeof title === 'string' ? tr(title, lang) : title[lang];
const colors = neutral
  ? [lineColor()]
  : [...new Set(lines)].sort((a, b) => a - b).map((number) => lineByNumber(number).color);
---

<div class:list={['section-head', className]}>
  <h2 class="section-title" id={id} tabindex="-1">{heading}</h2>
  {
    colors.length > 0 && (
      <span class="sh-band no-print" aria-hidden="true">
        {colors.map((color) => (
          <span style={`--line: ${color}`} />
        ))}
      </span>
    )
  }
  {intro && <p class="section-intro">{tr(intro, lang)}</p>}
</div>

<style>
  .section-head {
    margin-bottom: 32px;
  }

  .section-title {
    margin: 0;
  }

  /* Band of the related line colours under the sign: one 40px stretch per line, or a single stretch in the neutral
     line colour for a section that belongs to no job. */
  .sh-band {
    display: flex;
    width: fit-content;
    margin-top: 12px;
  }

  .sh-band span {
    width: 40px;
    height: 6px;
    background: var(--line);
  }

  .section-intro {
    margin: 16px 0 0;
  }
</style>
