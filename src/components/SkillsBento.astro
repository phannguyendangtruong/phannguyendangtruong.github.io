---
import RouteBullet from './metro/RouteBullet.astro';
import { lines, linesOfTech } from '../data/network';
import { skills } from '../data/profile';
import { projectCountForSkill, skillKey } from '../data/skill-keys';
import { trCount, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
/**
 * Interchange table: the skills by group; each row is a technology, a column of one slot per line (route order, an
 * empty slot when that company did not use it) and its number of projects. A row with projects is a button that
 * filters the route (script in home/SkillFilter.astro); the others are plain rows on the same columns.
 */
const groups = skills
  .filter((skill) => skill.items.length > 0)
  .map((skill) => ({
    title: skill.group[lang],
    rows: skill.items.map((name) => {
      const key = skillKey(name);
      const count = projectCountForSkill(key);
      const used = new Set(linesOfTech(key).map((line) => line.number));
      return {
        name,
        key,
        count,
        slots: lines.map((line) => (used.has(line.number) ? line.number : 0)),
        label: trCount('skillFilterOne', 'skillFilterMany', count, lang).replace('{name}', name),
        countText: trCount('filterCountOne', 'filterCountMany', count, lang),
      };
    }),
  }));
---

<div class="xt">
  {
    groups.map((group) => (
      <div class="xt-group">
        <h3 class="xt-title">{group.title}</h3>
        <ul class="xt-rows">
          {group.rows.map((row) => (
            <li>
              {row.count > 0 ? (
                <button
                  type="button"
                  class="xt-row xt-filter"
                  data-skill={row.key}
                  data-skill-name={row.name}
                  aria-pressed="false"
                  aria-label={row.label}
                  disabled
                >
                  <span class="xt-name">{row.name}</span>
                  <span class="xt-lines">
                    {row.slots.map((line) => (line > 0 ? <RouteBullet line={line} size="sm" /> : <span class="xt-slot" />))}
                  </span>
                  <span class="xt-count">{row.countText}</span>
                </button>
              ) : (
                <span class="xt-row">
                  <span class="xt-name">{row.name}</span>
                  <span class="xt-lines" aria-hidden="true">
                    {row.slots.map(() => (
                      <span class="xt-slot" />
                    ))}
                  </span>
                  <span class="xt-count" />
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  /* Groups flow in columns: one on phones, two from 640px, three from 1024px; a group never splits. */
  .xt {
    column-gap: 40px;
  }

  .xt-group {
    break-inside: avoid;
    margin-bottom: 28px;
  }

  .xt-title {
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    font: 600 0.9375rem/1.3 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* A ruled table: a thin rule under every row, no box around any of them. */
  .xt-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xt-rows li {
    border-bottom: 1px solid var(--border);
  }

  /* Every row is 44px or more, on the same three columns: name, one slot per line, project count. */
  .xt-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 5rem;
    align-items: center;
    column-gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 6px 8px;
    border: 0;
    border-radius: 0;
    background: transparent;
    font: 500 1rem/1.3 var(--font);
    color: var(--text);
    text-align: left;
  }

  /* A row with projects: background on hover and focus, the colours swapped while its filter is on. */
  .xt-filter {
    cursor: pointer;
    transition: background-color var(--t-hover), color var(--t-hover);
  }

  .xt-filter:disabled {
    cursor: default;
  }

  .xt-filter:enabled:hover,
  .xt-filter:focus-visible {
    background: var(--surface-2);
  }

  .xt-filter:focus-visible {
    outline-offset: -2px;
  }

  .xt-filter[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
  }

  .xt-name {
    min-width: 0;
  }

  /* Bullets of the same line stand in the same column: an empty slot keeps the place of a line that is not there. */
  .xt-lines {
    display: inline-flex;
    gap: 4px;
  }

  .xt-slot {
    width: 20px;
    height: 20px;
  }

  .xt-count {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--muted);
  }

  .xt-filter[aria-pressed='true'] .xt-count {
    color: inherit;
  }

  @media (min-width: 640px) {
    .xt {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .xt {
      columns: 3;
    }
  }
</style>
