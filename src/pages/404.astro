---
import Base from '../layouts/Base.astro';
import Station from '../components/metro/Station.astro';
import Track from '../components/metro/Track.astro';
import { lines } from '../data/network';
import { localePath, notFoundLabels, tr, type Lang } from '../i18n/ui';

type Point = [number, number];

const title = `${notFoundLabels.code} — ${tr('notFoundTitle', 'en')} · ${tr('notFoundTitle', 'vi')}`;
const description = `${tr('notFoundBody', 'en')} · ${tr('notFoundBody', 'vi')}`;
/** English first, then Vietnamese: each block leads to the home page and the CV in its language. */
const langs: Lang[] = ['en', 'vi'];
/** The line of the current job runs into a dashed, unbuilt section that ends at a station not on the map. */
const line = lines[lines.length - 1].number;
const built: Point[] = [[0, 44], [100, 44], [124, 20], [196, 20]];
const stops: Point[] = [[48, 44], [160, 20]];
const unknown: Point = [324, 20];
const unbuilt: Point[] = [built[built.length - 1], unknown];
---

<Base lang="en" title={title} description={description} path="/404/" variant="minimal" noindex>
  <div class="nf">
    <div class="container nf-in">
      <svg class="nf-map" viewBox="0 0 360 52" role="img" aria-labelledby="nf-map-title" aria-describedby="nf-map-desc">
        <title id="nf-map-title">{tr('notFoundMap', 'en')}</title>
        <desc id="nf-map-desc" lang="vi">{tr('notFoundMap', 'vi')}</desc>
        <Track line={line} points={built} />
        <Track line={line} points={unbuilt} dashed />
        {stops.map(([x, y]) => <Station x={x} y={y} line={line} />)}
        <Station x={unknown[0]} y={unknown[1]} line={line} r={16} />
        <text class="nf-unknown" x={unknown[0]} y={unknown[1] + 7} text-anchor="middle">{notFoundLabels.unknownStation}</text>
      </svg>
      <p class="nf-code">{notFoundLabels.code}</p>
      <h1 class="nf-title">
        <span class="part">{tr('notFoundTitle', 'en')}</span>{' '}
        <span class="part" lang="vi">{tr('notFoundTitle', 'vi')}</span>
      </h1>
      <div class="nf-langs">
        {
          langs.map((lang) => (
            <div class="nf-lang" lang={lang}>
              <p class="nf-body">{tr('notFoundBody', lang)}</p>
              <div class="nf-actions">
                <a class="button primary" href={localePath(lang, '/')} hreflang={lang}>
                  {tr('backHome', lang)}
                </a>
                <a class="button secondary" href={localePath(lang, '/cv/')} hreflang={lang}>
                  {tr('viewResume', lang)}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Base>

<style>
  /* Footer at the bottom of the screen; this stylesheet is only loaded by 404.html. */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  :global(#main) {
    flex: 1 0 auto;
    display: grid;
  }

  /* The block sits in the middle of the height between header and footer. */
  .nf {
    display: grid;
    align-items: center;
    padding: 40px 0 56px;
  }

  .nf-in {
    max-width: 880px;
  }

  /* The glow of the line in the dark theme may spill past the drawing instead of being cut at its edges. */
  .nf-map {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    overflow: visible;
  }

  /* Sign of the unknown station, inside its ring. */
  .nf-unknown {
    font: 700 20px var(--font-display);
    fill: var(--text);
  }

  /* Solid code in the sign face, quieter than the title. */
  .nf-code {
    margin: 28px 0 0;
    font: 700 clamp(3.5rem, 12vw, 6rem) / 0.9 var(--font-display);
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .nf-title {
    margin: 12px 0 0;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--text);
  }

  /* One line per language, Vietnamese second in the secondary text colour. */
  .nf-title .part {
    display: block;
  }

  .nf-title .part + .part {
    margin-top: 4px;
    color: var(--muted);
  }

  .nf-langs {
    display: grid;
    gap: 24px;
    margin-top: 32px;
  }

  .nf-lang {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  /* Phone: the Vietnamese block under a 1px rule. */
  .nf-lang + .nf-lang {
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .nf-body {
    max-width: 46ch;
    margin: 0;
    color: var(--muted);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .nf-actions .button {
    min-height: 48px;
    padding: 0 22px;
  }

  @media (min-width: 640px) {
    .nf {
      padding: 64px 0 80px;
    }

    .nf-map {
      max-width: 440px;
    }
  }

  /* From 720px: English and Vietnamese side by side, split by a 1px rule. */
  @media (min-width: 720px) {
    .nf-langs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }

    .nf-lang + .nf-lang {
      padding-top: 0;
      padding-left: 32px;
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }
</style>
