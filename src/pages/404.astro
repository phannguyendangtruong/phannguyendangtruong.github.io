---
import Base from '../layouts/Base.astro';
import { localePath, notFoundLabels, tr } from '../i18n/ui';

const title = `${notFoundLabels.code} — ${tr('notFoundTitle', 'en')} · ${tr('notFoundTitle', 'vi')}`;
const description = `${tr('notFoundTitle', 'en')} · ${tr('notFoundTitle', 'vi')}`;
const homeEn = localePath('en', '/');
const homeVi = localePath('vi', '/');
---

<Base lang="en" title={title} description={description} path="/404/" variant="minimal" noindex>
  <div class="nf">
    <div class="nf-bg no-print" aria-hidden="true">
      <div class="nf-grid"></div>
      <div class="nf-glow"></div>
      <div class="nf-noise"></div>
    </div>
    <div class="nf-state">
      <span class="nf-tick tl" aria-hidden="true"></span>
      <span class="nf-tick tr" aria-hidden="true"></span>
      <span class="nf-tick bl" aria-hidden="true"></span>
      <span class="nf-tick br" aria-hidden="true"></span>
      <p class="nf-code">{notFoundLabels.code}</p>
      <h1 class="nf-title">
        <span class="part">{tr('notFoundTitle', 'en')}</span>{' '}
        <span class="sep" aria-hidden="true">·</span>{' '}
        <span class="part" lang="vi">{tr('notFoundTitle', 'vi')}</span>
      </h1>
      <p class="nf-status">
        <span class="nf-pill"><span class="dot error" aria-hidden="true"></span>{notFoundLabels.status}</span>
      </p>
      <div class="nf-actions">
        <a class="button primary" href={homeEn}>{tr('backHome', 'en')}</a>
        <a class="button secondary" href={homeVi} hreflang="vi" lang="vi">{tr('backHome', 'vi')}</a>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Footer at the bottom of the screen; this stylesheet is only loaded by 404.html. */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  :global(#main) {
    flex: 1 0 auto;
    display: grid;
  }

  /* Clips the wide light, so the page never scrolls sideways. */
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 48px 16px 64px;
  }

  /* Still background like the home page hero: grid, light, grain. */
  .nf-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .nf-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center top;
    /* The mask only sets transparency; the colours are not displayed. */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 92%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 30%, transparent 92%);
  }

  .nf-glow {
    position: absolute;
    left: 50%;
    top: 40%;
    width: min(760px, 130%);
    aspect-ratio: 16 / 10;
    transform: translate(-50%, -50%);
    background: var(--hero-glow);
    filter: blur(8px);
  }

  /* Soft violet light below and to the right. */
  .nf-glow::after {
    content: '';
    position: absolute;
    left: 45%;
    top: 35%;
    width: 60%;
    height: 65%;
    background: var(--hero-glow-2);
  }

  .nf-noise {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 160px 160px;
  }

  /* Centred block without border or fill, marked by four corner ticks. */
  .nf-state {
    position: relative;
    width: min(100%, 820px);
    padding: 32px 16px 40px;
    text-align: center;
  }

  .nf-tick {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 0 solid var(--accent-2);
    opacity: 0.5;
  }

  .nf-tick.tl {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .nf-tick.tr {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-right-width: 1px;
  }

  .nf-tick.bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }

  .nf-tick.br {
    bottom: 0;
    right: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  /* Gradient code with a band of light; the still state keeps the band outside the text. */
  .nf-code {
    --nf-shine: var(--text);
    margin: 0;
    display: inline-block;
    padding: 0 0.06em;
    font: 700 clamp(88px, 20vw, 184px)/1 var(--mono);
    letter-spacing: -0.04em;
    background-image:
      linear-gradient(100deg, transparent 45%, var(--nf-shine) 50%, transparent 55%),
      linear-gradient(90deg, var(--accent) 0%, var(--accent-2) 25%, var(--accent-3) 50%, var(--accent-2) 75%, var(--accent) 100%);
    background-size: 300% 100%, 200% 100%;
    background-position: 0 0, 0 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :global(:root[data-theme='light']) .nf-code {
    --nf-shine: var(--surface);
  }

  /* Colours and light cross the code once after load; the end matches the still state. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .nf-code {
      animation: nf-sweep 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s 1 both;
    }
  }

  @keyframes nf-sweep {
    from {
      background-position: 100% 0, 100% 0;
    }

    to {
      background-position: 0 0, 0 0;
    }
  }

  .nf-title {
    margin: 24px 0 0;
    font-size: clamp(24px, 2.4vw + 12px, 32px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* One line per language until 960px. */
  .nf-title .part {
    display: block;
  }

  .nf-title .sep {
    display: none;
  }

  .nf-status {
    margin: 16px 0 0;
    display: flex;
    justify-content: center;
  }

  .nf-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font: 13px/1.4 var(--mono);
    letter-spacing: 0.01em;
    color: var(--muted);
  }

  .nf-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .nf {
      padding: 72px 24px 88px;
    }

    .nf-state {
      padding: 40px 56px 48px;
    }
  }

  @media (min-width: 960px) {
    .nf-title .part {
      display: inline-block;
      white-space: nowrap;
    }

    .nf-title .sep {
      display: inline;
      color: var(--muted);
      font-weight: 400;
    }
  }

  @media (forced-colors: active) {
    .nf-code {
      background: none;
      color: CanvasText;
    }
  }

  /* Browsers do not print backgrounds, so text clipped to one would disappear. */
  @media print {
    .nf-code {
      background: none;
      color: var(--text);
    }
  }
</style>
